{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Quartz": "Information",
      "TikTok.Analytics": "Information"
    }
  },
  "AllowedHosts": "*",
  "TikTokIngestion": {
    "HistoryStartDate": "2026-01-01",
    "LookbackDays": 60,
    "CronSchedule": "0 0 0 * * ?",
    "BigQuery": {
      "ProjectId": "your-gcp-project-id",
      "DatasetId": "tiktok_analytics"
    },
    "Pages": [
      {
        "PageId": "page_brand_1",
        "PageName": "My Brand TikTok",
        "BusinessId": "YOUR_BUSINESS_ID",
        "DisplayAccessToken": "YOUR_DISPLAY_OAUTH_TOKEN",
        "BusinessAccessToken": "YOUR_BUSINESS_OAUTH_TOKEN",
        "Enabled": true
      },
      {
        "PageId": "page_brand_2",
        "PageName": "Second Brand",
        "BusinessId": "YOUR_BUSINESS_ID_2",
        "DisplayAccessToken": "YOUR_DISPLAY_OAUTH_TOKEN_2",
        "BusinessAccessToken": "YOUR_BUSINESS_OAUTH_TOKEN_2",
        "Enabled": false
      }
    ]
  }
}
